# LINE Messaging API (from https://developers.line.biz/console/)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Local development only. Set to 1 to stub out LINE: pushes are logged instead
# of sent and profiles are faked, so `npm run seed` is enough to use the UI
# without real credentials. Never set this in production.
LINE_MOCK=

# Optional: Ably realtime push (https://ably.com/ -> API keys)
# Without this the app falls back to polling every 5 seconds.
ABLY_API_KEY=

# Public URL of your deployed app (set after Vercel deploy)
# Example: https://line-webchat.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
