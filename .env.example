# LINE Messaging API (from https://developers.line.biz/console/)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Optional: protect admin webchat with a simple password
WEBCHAT_ADMIN_PASSWORD=

# Public URL of your deployed app (set after Vercel deploy)
# Example: https://line-webchat.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
