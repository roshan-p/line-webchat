# LINE Messaging API (from https://developers.line.biz/console/)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Optional: Ably realtime push (https://ably.com/ -> API keys)
# Without this the app falls back to polling every 5 seconds.
ABLY_API_KEY=

# Public URL of your deployed app (set after Vercel deploy)
# Example: https://line-webchat.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
